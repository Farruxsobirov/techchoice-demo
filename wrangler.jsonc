/**
 * Cloudflare Workers config (used only when deploying to Cloudflare; Vercel ignores this file).
 * Build: npm run cf:build   Deploy: npm run cf:deploy   (or connect the GitHub repo in the Cloudflare dashboard)
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techchoice-demo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "techchoice-demo" }],
  // Page cache (see open-next.config.ts). The R2 bucket must exist in the account: R2 → Create bucket → "techchoice-cache".
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "techchoice-cache" }],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }],
  "observability": { "enabled": true },
  // Keep the *.workers.dev address (and per-version preview URLs) switched on in every account.
  "workers_dev": true,
  "preview_urls": true,
  // Variables set in the Cloudflare dashboard (e.g. REVALIDATE_SECRET) are kept on every deploy.
  "keep_vars": true,
  "vars": {
    // Tells the site it runs on Cloudflare: images are served straight from WordPress (no Vercel image optimizer).
    // WP_URL is also used at build time (scripts/cf-build.mjs reads it from here).
    "TC_TARGET": "cloudflare",
    "WP_URL": "https://cms.techchoice.com"
  }
}
